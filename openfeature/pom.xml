<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lichtsinn</groupId>
        <artifactId>ageris-parent</artifactId>
        <version>0.4.0</version>
    </parent>

    <artifactId>ageris-openfeature</artifactId>
    <name>Ageris OpenFeature Provider</name>
    <description>Lets an application use Ageris feature flags and JSON configs through the OpenFeature API</description>

    <properties>
        <!-- The version the provider is built against. The application brings its own; see the provided scope below. -->
        <openfeature.version>1.23.0</openfeature.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.lichtsinn</groupId>
            <artifactId>ageris-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Used directly for the JSON of a config, so not left to arrive through ageris-core. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Provided, so that the OpenFeature SDK an application uses is the one it chose itself. -->
        <dependency>
            <groupId>dev.openfeature</groupId>
            <artifactId>sdk</artifactId>
            <version>${openfeature.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Silences slf4j's "no binding" notice; the library leaves the binding choice to applications. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- The name of this jar for projects that use the Java module system. -->
                            <Automatic-Module-Name>io.github.lichtsinn.ageris.openfeature</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
