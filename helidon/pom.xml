<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lichtsinn</groupId>
        <artifactId>ageris-parent</artifactId>
        <version>0.8.0-SNAPSHOT</version>
    </parent>

    <artifactId>ageris-helidon</artifactId>
    <name>Ageris Helidon</name>
    <description>Sets up Ageris in a Helidon SE application from Helidon's configuration</description>

    <properties>
        <!-- Helidon 27 needs Java 27, so this module does too. The other modules stay on Java 17. -->
        <maven.compiler.release>27</maven.compiler.release>
        <helidon.version>27.0.0</helidon.version>
        <openfeature.version>1.23.0</openfeature.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.lichtsinn</groupId>
            <artifactId>ageris-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Used directly, to give Ageris a JSON mapper along with the loader threads of this module. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.config</groupId>
            <artifactId>helidon-config</artifactId>
            <version>${helidon.version}</version>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-registry</artifactId>
            <version>${helidon.version}</version>
        </dependency>

        <!-- Optional: an application only gets these by adding them itself. Helidon's service registry loads the services
             that need them only when something asks for them. -->
        <dependency>
            <groupId>io.helidon.health</groupId>
            <artifactId>helidon-health</artifactId>
            <version>${helidon.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.lichtsinn</groupId>
            <artifactId>ageris-openfeature</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>dev.openfeature</groupId>
            <artifactId>sdk</artifactId>
            <version>${openfeature.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Silences slf4j's "no binding" notice; the library leaves the binding choice to applications. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Writes what Helidon's service registry needs to find the services of this module. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.helidon.bundles</groupId>
                            <artifactId>helidon-bundles-apt</artifactId>
                            <version>${helidon.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <!-- PMD does not know Java 27 yet. The sources of this module use nothing newer than Java 17, so they are
                         checked as that; and PMD does not look into compiled classes here, since it cannot read those of
                         Java 27. The classes that Helidon generates are not ours to check. -->
                    <targetJdk>17</targetJdk>
                    <typeResolution>false</typeResolution>
                    <!-- A file PMD cannot read, as one with newer syntax would be, fails the build, where it would
                         otherwise be left out of the check with only a warning. -->
                    <skipPmdError>false</skipPmdError>
                    <excludeRoots>
                        <excludeRoot>${project.build.directory}/generated-sources/annotations</excludeRoot>
                    </excludeRoots>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- What Helidon generates for its service registry is no part of what an application uses. -->
                    <sourceFileExcludes>
                        <sourceFileExclude>**/*__ServiceDescriptor.java</sourceFileExclude>
                    </sourceFileExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- The name of this jar for projects that use the Java module system. -->
                            <Automatic-Module-Name>io.github.lichtsinn.ageris.helidon</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
